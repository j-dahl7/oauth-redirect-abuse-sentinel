// =============================================================================
// OAuth Redirect Abuse Hunting Queries for Microsoft Sentinel
// Companion lab: j-dahl7/oauth-redirect-abuse-sentinel
// =============================================================================

// -----------------------------------------------------------------------------
// HUNT 1: Observed Client Service Principals with Delegated Grants
// Purpose: Identify clients in retained delegated-grant events
// -----------------------------------------------------------------------------
// Observed delegated grants, not a complete live permission inventory.
AuditLogs
| where TimeGenerated > ago(90d)
| where OperationName == "Add delegated permission grant"
| extend ConsentUser = tostring(InitiatedBy.user.userPrincipalName)
| mv-apply TargetResource = TargetResources on (
    where TargetResource.type =~ "ServicePrincipal"
    | mv-apply Property = TargetResource.modifiedProperties on (
        extend PropertyName = tostring(Property.displayName),
            PropertyValue = trim('"', tostring(Property.newValue))
        | summarize
            ClientIds = make_set_if(PropertyValue, PropertyName =~ "ServicePrincipal.ObjectID"),
            ClientNames = make_set_if(PropertyValue, PropertyName =~ "ServicePrincipal.DisplayName"),
            Permissions = make_set_if(PropertyValue, PropertyName in~ ("DelegatedPermissionGrant.Scope", "AppRole.Value"))
    )
)
// TargetResource.id can be the resource API. Only the explicit client property
// identifies the recipient; absent/ambiguous identities stay out of this join.
| where array_length(ClientIds) == 1 and array_length(Permissions) > 0
| extend ClientServicePrincipalId = tolower(tostring(ClientIds[0])),
    ClientDisplayName = tostring(ClientNames[0])
| summarize PermissionsGranted = make_set(Permissions), GrantCount = count(),
    Users = make_set(ConsentUser, 50), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated)
    by ClientServicePrincipalId, ClientDisplayName
| sort by GrantCount desc

// -----------------------------------------------------------------------------
// HUNT 2: OAuth Sign-ins from Non-Corporate IPs
// Purpose: Find OAuth app authentications from unexpected locations
// -----------------------------------------------------------------------------
let CorporateNetworks = dynamic(["203.0.113.0/24", "198.51.100.0/24"]);   // your IPv4 ranges
let CorporateNetworksV6 = dynamic([]);                                    // your IPv6 ranges, if any
// Populate only with immutable AppId values that your tenant has reviewed.
// An empty list suppresses nothing; application display names are attacker-controlled.
let ApprovedAppIds = dynamic([]);
SigninLogs
| where TimeGenerated > ago(30d)
| extend AppIdUsed = AppId
| where isempty(AppIdUsed) or AppIdUsed !in~ (ApprovedAppIds)
| where ResourceDisplayName has "Graph" or ResourceDisplayName has "Office 365"
// coalesce, not ==false: ipv4_is_in_any_range returns null for an IPv6 address,
// and `null == false` is null, so a bare comparison discarded every IPv6 row.
// Anything we cannot positively place inside a corporate range is treated as
// non-corporate, which is the safe default for a hunt.
| extend IsCorporate = coalesce(
    ipv4_is_in_any_range(IPAddress, CorporateNetworks),
    ipv6_is_in_any_range(IPAddress, CorporateNetworksV6),
    false)
| where not(IsCorporate)
| summarize
    SignInCount = count(),
    DistinctIPs = dcount(IPAddress),
    IPs = make_set(IPAddress, 10),
    Users = make_set(UserPrincipalName, 10),
    Locations = make_set(strcat(Location, " (", LocationDetails.city, ")"), 10)
    by AppDisplayName, AppId
| where SignInCount > 5
| sort by DistinctIPs desc

// -----------------------------------------------------------------------------
// HUNT 3: Recently Provisioned Service Principals with High-Privilege Grants
// Purpose: Join retained provisioning and grant events by the client SP object ID.
// App-registration object IDs and service-principal IDs are different namespaces.
// -----------------------------------------------------------------------------
let HighPrivilegeScopes = dynamic([
    "Mail.Read", "Mail.ReadWrite", "Mail.Send",
    "Files.ReadWrite.All", "Files.Read.All",
    "User.ReadWrite.All", "Directory.ReadWrite.All",
    "Sites.ReadWrite.All", "MailboxSettings.ReadWrite",
    "Contacts.ReadWrite", "People.Read.All"
]);
let RecentServicePrincipals = AuditLogs
| where TimeGenerated > ago(14d)
| where OperationName == "Add service principal"
| mv-expand TargetResource = TargetResources
| where TargetResource.type =~ "ServicePrincipal"
| extend ClientServicePrincipalId = tolower(tostring(TargetResource.id)),
    CreatedBy = tostring(InitiatedBy.user.userPrincipalName)
| where isnotempty(ClientServicePrincipalId)
| summarize CreatedAt = min(TimeGenerated), CreatedBy = take_any(CreatedBy) by ClientServicePrincipalId;
AuditLogs
| where TimeGenerated > ago(14d)
| where OperationName in ("Add delegated permission grant", "Add app role assignment to service principal")
| mv-apply TargetResource = TargetResources on (
    where TargetResource.type =~ "ServicePrincipal"
    | mv-apply Property = TargetResource.modifiedProperties on (
        extend PropertyName = tostring(Property.displayName),
            PropertyValue = trim('"', tostring(Property.newValue))
        | summarize
            ClientIds = make_set_if(PropertyValue, PropertyName =~ "ServicePrincipal.ObjectID"),
            ClientNames = make_set_if(PropertyValue, PropertyName =~ "ServicePrincipal.DisplayName"),
            Permissions = make_set_if(PropertyValue, PropertyName in~ ("DelegatedPermissionGrant.Scope", "AppRole.Value"))
    )
)
// TargetResource.id can be the resource API. Only the explicit client property
// identifies the recipient; absent/ambiguous identities stay out of this join.
| where array_length(ClientIds) == 1 and array_length(Permissions) > 0
| extend ClientServicePrincipalId = tolower(tostring(ClientIds[0])),
    ClientDisplayName = tostring(ClientNames[0])
| mv-expand Permission = Permissions to typeof(string)
| where Permission has_any (HighPrivilegeScopes)
| join kind=inner (RecentServicePrincipals) on ClientServicePrincipalId
| where TimeGenerated >= CreatedAt
| summarize Scopes = make_set(Permission), FirstGrant = min(TimeGenerated), LastGrant = max(TimeGenerated)
    by ClientServicePrincipalId, ClientDisplayName, CreatedAt, CreatedBy

// -----------------------------------------------------------------------------
// HUNT 4: OAuth Redirect URI Inventory
// Purpose: Full inventory of redirect URIs across all app registrations
// Run via Graph API (PowerShell) — KQL for audit trail only
// -----------------------------------------------------------------------------
AuditLogs
| where TimeGenerated > ago(90d)
| where OperationName in ("Add application", "Update application")
| mv-expand ModifiedProperty = TargetResources[0].modifiedProperties
| where ModifiedProperty.displayName == "AppAddress"
| extend RedirectUris = tostring(ModifiedProperty.newValue)
| extend AppName = tostring(TargetResources[0].displayName)
| extend ModifiedBy = coalesce(
    tostring(InitiatedBy.user.userPrincipalName),
    tostring(InitiatedBy.app.displayName)
)
| project TimeGenerated, AppName, RedirectUris, ModifiedBy, OperationName
| sort by TimeGenerated desc

// -----------------------------------------------------------------------------
// HUNT 5: Authorization Error Followed by New-IP Authentication
// Purpose: Find an OAuth authorization error followed by successful sign-in
//   from a different IP. Triage lead only: these codes do not prove a redirect
//   or token relay, and can reflect ordinary consent or application configuration.
//   This same-AppId hunt does not correlate a cross-application redirect campaign.
// -----------------------------------------------------------------------------
let OAuthErrors = SigninLogs
    | where TimeGenerated > ago(7d)
    | where ResultType in ("65001", "65004", "70011", "700016", "70000", "7000218")
    | extend CorrelationUserId = tolower(UserId)
    | where isnotempty(CorrelationUserId)
    | project ErrorTime = TimeGenerated, CorrelationUserId, UserPrincipalName, ErrorIP = IPAddress, AppId, ResultType;
let SuccessfulSignIns = SigninLogs
    | where TimeGenerated > ago(7d)
    | where ResultType == "0"
    | extend CorrelationUserId = tolower(UserId)
    | where isnotempty(CorrelationUserId)
    | project SuccessTime = TimeGenerated, CorrelationUserId, UserPrincipalName, SuccessIP = IPAddress, AppId, TokenIssuerType;
OAuthErrors
| join kind=inner (SuccessfulSignIns) on CorrelationUserId, AppId
| where SuccessTime between (ErrorTime .. (ErrorTime + 30m))
| where ErrorIP != SuccessIP
| project
    ErrorTime,
    SuccessTime,
    UserPrincipalName,
    AppId,
    ErrorIP,
    SuccessIP,
    TimeDelta = SuccessTime - ErrorTime
